# Configuración web de Firebase (Consola → Configuración del proyecto → Tus apps).
# Sin estas variables, en desarrollo la app usa datos locales de prueba.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check con reCAPTCHA v3 (opcional). Si está vacío, App Check no se inicializa.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# En localhost con App Check activo: "true" genera un token de depuración en la consola del navegador.
NEXT_PUBLIC_APPCHECK_DEBUG=

# "true" usa los datos y cuentas de prueba aunque sea producción, para publicar una demo.
# Tiene prioridad sobre la configuración de Firebase. Nunca en el sitio real.
NEXT_PUBLIC_DATOS_DE_PRUEBA=
